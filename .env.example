# Copy to .env and fill in. Never commit the real .env.
DB_USERNAME=booking
DB_PASSWORD=change-me-strong-password
# openssl rand -base64 48
JWT_SECRET=
APP_URL=http://localhost:8081
WEB_PORT=8081

# First admin account (created once, on an empty database)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123

# Simulated payment gateway (no Razorpay keys needed). Keep false in production.
PAYMENTS_DEMO_MODE=false

# E-mail (defaults to the bundled MailHog; for production use SendGrid/SES SMTP)
MAIL_ENABLED=true
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@sloto.local

# SMS: log | twilio
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google Identity Services client id (enables "Sign in with Google")
GOOGLE_CLIENT_ID=

# Razorpay (test or live keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

BACKUP_KEEP_DAYS=7
